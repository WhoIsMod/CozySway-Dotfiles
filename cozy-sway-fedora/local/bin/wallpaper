#!/usr/bin/env bash
export PATH="$HOME/.local/bin:$HOME/.cargo/bin:/usr/local/sbin:/usr/sbin:/sbin:$PATH"
# swww wallpaper manager (swww was renamed awww; both are supported).
# Usage: wallpaper {init|next|random|set <file>}
set -uo pipefail

if command -v awww >/dev/null 2>&1; then CLI=awww; DAEMON=awww-daemon
else CLI=swww; DAEMON=swww-daemon; fi

DIR="${WALLPAPER_DIR:-$HOME/Pictures/Wallpapers}"
STATE="$HOME/.local/state/wallpaper"
mkdir -p "$(dirname "$STATE")" "$DIR"

ensure_daemon() {
    "$CLI" query >/dev/null 2>&1 && return 0
    setsid -f "$DAEMON" >/dev/null 2>&1
    for _ in $(seq 25); do
        "$CLI" query >/dev/null 2>&1 && return 0
        sleep 0.2
    done
    echo "could not start $DAEMON" >&2; exit 1
}

apply() {
    echo "$1" > "$STATE"
    "$CLI" img "$1" --transition-type "${2:-grow}" --transition-duration 1.2 --transition-fps 60
}

list() {
    find -L "$DIR" -type f \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' \
        -o -iname '*.webp' -o -iname '*.gif' \) | sort
}

ensure_daemon
case "${1:-}" in
    init)
        if [[ -f "$STATE" && -f "$(cat "$STATE")" ]]; then apply "$(cat "$STATE")" none
        else f="$(list | head -n1)"; [[ -n "$f" ]] && apply "$f" none; fi ;;
    next)
        mapfile -t files < <(list); (( ${#files[@]} )) || exit 0
        cur="$(cat "$STATE" 2>/dev/null || true)"; idx=-1
        for i in "${!files[@]}"; do [[ "${files[$i]}" == "$cur" ]] && idx=$i; done
        apply "${files[$(( (idx + 1) % ${#files[@]} ))]}" ;;
    random)
        f="$(list | shuf -n1)"; [[ -n "$f" ]] && apply "$f" ;;
    set)
        [[ -f "${2:-}" ]] || { echo "usage: wallpaper set <file>"; exit 1; }
        apply "$(realpath "$2")" ;;
    *) echo "Usage: $0 {init|next|random|set <file>}"; exit 1 ;;
esac
