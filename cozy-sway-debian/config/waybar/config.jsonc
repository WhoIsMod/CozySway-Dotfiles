{
    "layer": "top",
    "position": "bottom",
    "height": 40,
    "spacing": 4,
    "reload_style_on_change": true,

    "modules-left": ["custom/launcher", "sway/workspaces", "sway/window"],
    "modules-center": [
        "custom/dock-terminal", "custom/dock-files", "custom/dock-browser",
        "custom/dock-discord", "custom/dock-spotify", "custom/dock-steam"
    ],
    "modules-right": [
        "mpris", "custom/obs", "custom/mode", "idle_inhibitor", "clock", "custom/weather",
        "cpu", "memory", "custom/uptime", "custom/vpn", "bluetooth", "backlight", "wireplumber", "pulseaudio#mic", "network", "battery", "tray", "custom/power"
    ],

    "custom/launcher": { "format": "\uf00a", "tooltip": false, "on-click": "fuzzel" },

    "sway/workspaces": {
        "all-outputs": true,
        "disable-scroll": false,
        "format": "{icon}",
        "format-icons": { "default": "○", "focused": "●", "urgent": "◉" },
        "persistent-workspaces": { "*": 5 }
    },
    "sway/window": { "max-length": 40, "rewrite": { "(.*) — Mozilla Firefox": "$1" } },

    "custom/dock-terminal": { "format": "\uf120", "tooltip-format": "Terminal", "on-click": "kitty" },
    "custom/dock-files":    { "format": "\uf07b", "tooltip-format": "Files",    "on-click": "dolphin" },
    "custom/dock-browser":  { "format": "\uf269", "tooltip-format": "Browser",  "on-click": "firefox" },
    "custom/dock-discord":  { "format": "\uf392", "tooltip-format": "Discord",  "on-click": "discord" },
    "custom/dock-spotify":  { "format": "\uf1bc", "tooltip-format": "Spotify",  "on-click": "spotify" },
    "custom/dock-steam":    { "format": "\uf1b6", "tooltip-format": "Steam",    "on-click": "steam" },

    "mpris": {
        "format": "<span color='#a9d9a0'>{player_icon}</span> {artist} — {title}",
        "format-paused": "<span color='#ecd08a'>{player_icon}</span> {title}",
        "player-icons": { "default": "\uf001", "spotify": "\uf1bc" },
        "max-length": 42,
        "on-click": "playerctl play-pause",
        "on-click-right": "playerctl next"
    },

    "custom/mode": {
        "exec": "~/.local/bin/waybar-mode",
        "return-type": "json",
        "interval": 5,
        "signal": 8,
        "on-click": "~/.local/bin/desktop-mode toggle",
        "on-click-right": "~/.local/bin/desktop-mode menu"
    },

    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": { "activated": "\uf06e", "deactivated": "\uf070" },
        "tooltip-format-activated": "Screen stays awake",
        "tooltip-format-deactivated": "Screen may sleep"
    },

    "clock": {
        "format": "<span color='#8aa4ff'>\uf017</span> {:%H:%M}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "format-alt": "<span color='#8aa4ff'>\uf073</span> {:%a %d %b}"
    },

    "custom/weather": { "exec": "~/.local/bin/waybar-weather", "interval": 900 },

    "cpu":    { "format": "<span color='#8ad6e0'>\uf2db</span> {usage}%", "interval": 2 },
    "memory": { "format": "<span color='#b4a0ff'>\uf538</span> {percentage}%", "interval": 2 },
    "custom/uptime": { "exec": "~/.local/bin/waybar-uptime", "interval": 60 },

    "wireplumber": {
        "format": "<span color='#8aa4ff'>\uf028</span> {volume}%",
        "format-muted": "<span color='#ef8e9a'>\uf026</span> muted",
        "scroll-step": 5,
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },

    "network": {
        "format-wifi": "<span color='#a9d9a0'>\uf1eb</span> {signalStrength}%",
        "format-ethernet": "<span color='#a9d9a0'>\uf0ac</span>",
        "format-disconnected": "<span color='#ef8e9a'>\uf071</span> offline",
        "tooltip-format": "{ifname}  {ipaddr}",
        "on-click": "nm-connection-editor"
    },

    "custom/vpn": {
        "exec": "~/.local/bin/openvpn-status",
        "return-type": "json",
        "interval": 3,
        "signal": 9,
        "on-click": "~/.local/bin/openvpn-menu",
        "on-click-right": "~/.local/bin/openvpn-menu disconnect"
    },

    "custom/obs": {
        "exec": "~/.local/bin/waybar-obs",
        "return-type": "json",
        "interval": 3,
        "on-click": "~/.local/bin/obs-open",
        "on-click-right": "~/.local/bin/desktop-mode stream"
    },

    "bluetooth": {
        "format": "<span color='#8aa4ff'>\uf294</span>",
        "format-off": "<span color='#6f7896'>\uf294</span>",
        "format-disabled": "<span color='#6f7896'>\uf294</span>",
        "format-connected": "<span color='#a9d9a0'>\uf294</span> {num_connections}",
        "format-connected-battery": "<span color='#a9d9a0'>\uf294</span> {device_alias} {device_battery_percentage}%",
        "tooltip-format": "{controller_alias}  {controller_address}\n{num_connections} connected",
        "tooltip-format-connected": "{controller_alias}\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "tooltip-format-enumerate-connected-battery": "{device_alias}  {device_battery_percentage}%",
        "on-click": "~/.local/bin/bluetooth-menu",
        "on-click-right": "~/.local/bin/bluetooth-menu toggle"
    },

    "battery": {
        "states": { "warning": 30, "critical": 15 },
        "format": "{icon} {capacity}%",
        "format-charging": "\uf0e7 {capacity}%",
        "format-plugged": "\uf1e6 {capacity}%",
        "format-icons": ["\uf244", "\uf243", "\uf242", "\uf241", "\uf240"],
        "tooltip-format": "{timeTo}  ({power} W)"
    },

    "backlight": {
        "format": "<span color='#ecd08a'>\uf185</span> {percent}%",
        "on-scroll-up": "brightnessctl set +5%",
        "on-scroll-down": "brightnessctl set 5%-"
    },

    "pulseaudio#mic": {
        "format": "{format_source}",
        "format-source": "<span color='#a9d9a0'>\uf130</span>",
        "format-source-muted": "<span color='#ef8e9a'>\uf131</span>",
        "tooltip-format": "{source_desc}\n{source_volume}%\nClick: choose input, right-click: mute, scroll: volume",
        "scroll-step": 5,
        "on-click": "~/.local/bin/mic-menu",
        "on-click-right": "pactl set-source-mute @DEFAULT_SOURCE@ toggle",
        "on-scroll-up": "pactl set-source-volume @DEFAULT_SOURCE@ +5%",
        "on-scroll-down": "pactl set-source-volume @DEFAULT_SOURCE@ -5%"
    },

    "tray": { "icon-size": 18, "spacing": 8 },

    "custom/power": { "format": "\uf011", "tooltip": false, "on-click": "~/.local/bin/desktop-mode menu" }
}
