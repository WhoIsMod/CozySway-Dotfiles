# ============================================================
# Cozy Dark Sway  (Wayland / PipeWire / swww)
# ============================================================
set $mod Mod4
set $term kitty
set $menu fuzzel
set $browser firefox
set $files dolphin

# Cozy dark palette
set $bg      #1a1d2b
set $bg_alt  #232738
set $surface #2c3147
set $fg      #d9deee
set $muted   #8b93b0
set $accent  #8aa4ff
set $accent2 #b4a0ff
set $red     #ef8e9a

font pango:JetBrainsMono Nerd Font 10

# Input (add your xkb_layout here if needed)
input type:touchpad {
    tap enabled
    natural_scroll enabled
    dwt enabled
}

# ---------- Startup ----------
# Register the Sway session with systemd/D-Bus so portals (file pickers, screen share) work
exec_always dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway SWAYSOCK
exec_always ~/.local/bin/wallpaper init
# Dark mode for GTK apps, file dialogs and browsers (read via xdg-desktop-portal)
exec_always gsettings set org.gnome.desktop.interface color-scheme prefer-dark
exec_always gsettings set org.gnome.desktop.interface gtk-theme Adwaita-dark
exec_always sh -c 'pkill -x waybar; exec waybar'
exec mako
exec nm-applet --indicator
exec sh -c '[ -x /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 ] && exec /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 || exec /usr/lib/polkit-kde-authentication-agent-1'
exec swayidle -w \
    timeout 600 'swaylock -f' \
    timeout 900 'swaymsg "output * power off"' \
    resume 'swaymsg "output * power on"' \
    before-sleep 'swaylock -f'

# ---------- Look ----------
gaps inner 8
gaps outer 4
smart_gaps on
smart_borders on
default_border pixel 2
default_floating_border pixel 2

#                       border   background text  indicator child_border
client.focused          $accent  $bg_alt   $fg   $accent2  $accent
client.focused_inactive $surface $bg       $muted $surface  $surface
client.unfocused        $bg_alt  $bg       $muted $bg_alt   $bg_alt
client.urgent           $red     $red      $bg    $red      $red

# Rounded corners / blur (only applied on SwayFX; empty file on plain Sway)
include ~/.config/sway/fx.conf

# ---------- Apps ----------
bindsym $mod+Return exec $term
bindsym $mod+d exec $menu
bindsym $mod+b exec $browser
bindsym $mod+e exec $files

bindsym $mod+Shift+q kill
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r reload

# ---------- Focus / move ----------
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# ---------- Layout ----------
bindsym $mod+v splitv
bindsym $mod+s splith
bindsym $mod+f fullscreen toggle
bindsym $mod+space floating toggle
bindsym $mod+Shift+space focus mode_toggle
bindsym $mod+a focus parent
floating_modifier $mod normal

mode "resize" {
    bindsym h resize shrink width 20px
    bindsym j resize grow height 20px
    bindsym k resize shrink height 20px
    bindsym l resize grow width 20px
    bindsym Left resize shrink width 20px
    bindsym Down resize grow height 20px
    bindsym Up resize shrink height 20px
    bindsym Right resize grow width 20px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

# ---------- Workspaces ----------
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

# ---------- Audio (PipeWire / WirePlumber) ----------
bindsym --locked XF86AudioRaiseVolume exec wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+
bindsym --locked XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym --locked XF86AudioMute        exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym --locked XF86AudioMicMute     exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
bindsym --locked XF86AudioPlay exec playerctl play-pause
bindsym --locked XF86AudioNext exec playerctl next
bindsym --locked XF86AudioPrev exec playerctl previous
bindsym --locked XF86MonBrightnessUp   exec brightnessctl set +5%
bindsym --locked XF86MonBrightnessDown exec brightnessctl set 5%-

bindsym $mod+n exec pavucontrol
bindsym $mod+Shift+n exec nm-connection-editor

# ---------- Wallpaper (swww / awww) ----------
bindsym $mod+w exec ~/.local/bin/wallpaper next
bindsym $mod+Shift+w exec ~/.local/bin/wallpaper random

# ---------- VPN ----------
bindsym $mod+Shift+v exec ~/.local/bin/openvpn-menu

# ---------- Streaming / Bluetooth ----------
bindsym $mod+Shift+o exec ~/.local/bin/desktop-mode stream
bindsym $mod+o exec ~/.local/bin/obs-open
bindsym $mod+Shift+t exec ~/.local/bin/bluetooth-menu
bindsym $mod+Shift+m exec ~/.local/bin/mic-menu
# Hide/show the panel (it shows IPs, weather, Wi-Fi) if you capture the whole monitor
bindsym $mod+Shift+i exec pkill -SIGUSR1 waybar

# ---------- Screenshots / lock ----------
bindsym Print exec grim -g "$(slurp)" ~/Pictures/screenshot-$(date +%Y%m%d-%H%M%S).png
bindsym Shift+Print exec grim ~/Pictures/screenshot-$(date +%Y%m%d-%H%M%S).png
bindsym $mod+Shift+x exec swaylock -f

# ---------- Game / Business mode ----------
bindsym $mod+g exec ~/.local/bin/desktop-mode toggle
bindsym $mod+Shift+g exec ~/.local/bin/launch-game
bindsym $mod+Shift+b exec ~/.local/bin/desktop-mode business
bindsym $mod+m exec ~/.local/bin/desktop-mode menu

set $mode_system System: [g] Gaming [s] Stream [b] Business [l] Lock [q] Logout
mode "$mode_system" {
    bindsym g exec ~/.local/bin/desktop-mode game, mode "default"
    bindsym s exec ~/.local/bin/desktop-mode stream, mode "default"
    bindsym b exec ~/.local/bin/desktop-mode business, mode "default"
    bindsym l exec swaylock -f, mode "default"
    bindsym q exec swaymsg exit
    bindsym Escape mode "default"
    bindsym Return mode "default"
}
bindsym $mod+Escape mode "$mode_system"

# ---------- Window rules ----------
for_window [app_id="pavucontrol"] floating enable
for_window [app_id="nm-connection-editor"] floating enable
for_window [app_id="org.kde.polkit-kde-authentication-agent-1"] floating enable
for_window [class="steam"] move to workspace number 5
for_window [class="steam_app_.*"] move to workspace number 5

# ---------- OBS Studio ----------
assign [app_id="com.obsproject.Studio"] workspace number 9
assign [class="obs"] workspace number 9
for_window [app_id="com.obsproject.Studio"] inhibit_idle open
for_window [class="obs"] inhibit_idle open
for_window [title="^(Windowed|Fullscreen) Projector.*"] floating enable

# ---------- File chooser / upload dialogs: floating, sensible size, centred ----------
for_window [app_id="xdg-desktop-portal-gtk"] floating enable, resize set width 60 ppt height 70 ppt, move position center
for_window [app_id="xdg-desktop-portal-kde"] floating enable, resize set width 60 ppt height 70 ppt, move position center
for_window [app_id="zenity"] floating enable, move position center
for_window [title="^(File Upload|Open File|Open Files|Save As|Save File|Choose File.*|Select File.*)$"] floating enable, resize set width 60 ppt height 70 ppt, move position center
